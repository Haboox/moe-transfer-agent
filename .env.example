# Copy this file to ".env" and edit it. ".env" is never committed to git (it can hold an API key).

# Which AI model the agent uses:
#   ollama    = local model on this computer (free; Ollama must be running)
#   hosted    = a hosted model behind the OpenAI style API, for example Groq or Google Gemini (needs HOSTED_API_KEY);
#               used by the online copy of the portal (plan B, see docs/09_online_copy.md)
#   anthropic = Claude API (needs ANTHROPIC_API_KEY below)
#   scripted  = no AI; a fixed rule-following planner (used for repeatable tests)
LLM_PROVIDER=ollama

# Local model (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Qwen3 can "think" before answering; off is much faster on a small GPU
OLLAMA_THINK=false
# Working memory of the model in tokens (Ollama's default 4096 is too small for this agent)
OLLAMA_NUM_CTX=8192
# Optional, only if Ollama is installed somewhere unusual: its folder, and where its models are kept
OLLAMA_DIR=
OLLAMA_MODELS=

# Hosted model (only used when LLM_PROVIDER=hosted). Groq by default; for Google Gemini use
#   HOSTED_URL=https://generativelanguage.googleapis.com/v1beta/openai   and a Gemini model name
HOSTED_API_KEY=
HOSTED_URL=https://api.groq.com/openai/v1
HOSTED_MODEL=openai/gpt-oss-120b
# Backup models, used in this order when the main model's free allowance is used up (each has its own allowance)
HOSTED_FALLBACK_MODELS=openai/gpt-oss-20b
# Optional: sent as reasoning_effort (for example none, low); leave empty for the model's default
HOSTED_REASONING=

# Claude API (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Agent limits
LLM_TIMEOUT_SECONDS=180
MAX_TOOL_STEPS=10
TOOL_MAX_RETRIES=1

# Mock systems timing (realistic timeouts): normal answer time, how long a "hung" system hangs,
# and how long the agent waits before treating a call as timed out
MOCK_LATENCY_SECONDS=0.3
MOCK_HANG_SECONDS=6
TOOL_TIMEOUT_SECONDS=3

# Longest message the parent can type
CHAT_MAX_CHARS=600

# Leave empty to use today's date. Tests always use a fixed date (2026-10-12).
APPLICATION_DATE=
